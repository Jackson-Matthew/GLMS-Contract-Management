@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In | GLMS</title>
    <script>
        (function () {
            var t = localStorage.getItem('theme');
            var dark = t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches);
            document.documentElement.setAttribute('data-bs-theme', dark ? 'dark' : 'light');
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <section class="ud-auth">
        <div class="ud-auth-box">
            <div class="mb-4">
                <span class="ud-logo">
                    <span class="ud-logo-mark"><i class="fas fa-globe-africa"></i></span>
                    <span class="ud-logo-text">GLMS</span>
                </span>
                <p class="mt-3 mb-0">Global Logistics Management Service</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger text-start">@ViewBag.Error</div>
            }

            <form method="post">
                <input type="text" name="username" class="form-control" placeholder="Username" required autocomplete="off" aria-label="Username" />
                <input type="password" name="password" class="form-control" placeholder="Password" required aria-label="Password" />
                <button type="submit" class="btn btn-primary mb-4">Sign In</button>
            </form>

            <p class="mb-0 text-muted small">
                Demo credentials &mdash; username: <strong>admin</strong> / password: <strong>password</strong>
            </p>

            <svg class="ud-auth-dots top" width="40" height="40" viewBox="0 0 40 40" fill="#3056D3" aria-hidden="true">
                @for (var r = 0; r < 4; r++) { for (var c = 0; c < 4; c++) { <circle cx="@(2 + c * 12)" cy="@(2 + r * 12)" r="1.4" /> } }
            </svg>
            <svg class="ud-auth-dots bottom" width="40" height="40" viewBox="0 0 40 40" fill="#3056D3" aria-hidden="true">
                @for (var r = 0; r < 4; r++) { for (var c = 0; c < 4; c++) { <circle cx="@(2 + c * 12)" cy="@(2 + r * 12)" r="1.4" /> } }
            </svg>
        </div>
    </section>
</body>
</html>
