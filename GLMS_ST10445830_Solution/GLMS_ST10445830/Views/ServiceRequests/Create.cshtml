@model GLMS_ST10445830.Models.ServiceRequest

@{
    ViewData["Title"] = "Create Service Request";
}


<hr />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="alert alert-info">
                <strong>Note:</strong> Service requests can only be created for Active contracts.
                Expired contracts cannot have new service requests.
            </div>

            <div class="form-group">
                <label asp-for="ContractId" class="control-label"></label>
                <select asp-for="ContractId" class="form-control" asp-items="@(ViewData["ContractId"] as List<SelectListItem>)">
                </select>
                <span asp-validation-for="ContractId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="USDAmount" class="control-label">Amount (USD)</label>
                <input asp-for="USDAmount" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="USDAmount" class="text-danger"></span>
                <small class="form-text text-muted">Enter amount in USD. It will be converted to ZAR automatically.</small>
            </div>

            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<GLMS_ST10445830.Models.ServiceRequest.RequestStatus>()">
                    <option value="">-- Select Status --</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}