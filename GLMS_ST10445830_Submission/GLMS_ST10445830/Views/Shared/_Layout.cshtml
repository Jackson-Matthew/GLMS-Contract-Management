<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GLMS_ST10445830</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GLMS_ST10445830.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>
    <div class="d-flex">

        <div class="bg-dark text-white p-3 vh-100" style="width: 250px; position: fixed;">
            <h4 class="text-center mb-4"> TechMove GLMS 
            </h4>

            <ul class="nav flex-column">

                <li class="nav-item mb-2">
                    <a class="nav-link text-white" asp-controller="Home" asp-action="Index">
                        <i class="text-center mb-4"></i> Dashboard
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a class="nav-link text-white" asp-controller="Clients" asp-action="Index">
                        <i class="text-center mb-4"></i> Clients
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a class="nav-link text-white" asp-controller="Contracts" asp-action="Index">
                        <i class="text-center mb-4"></i> Contracts
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a class="nav-link text-white" asp-controller="ServiceRequests" asp-action="Index">
                        <i class="text-center mb-4"></i> Service Requests
                    </a>
                </li>
            </ul>
        </div>

        <div class="flex-grow-1" style="margin-left: 250px;">

            <nav class="navbar navbar-light bg-white border-bottom px-4">
                <span class="navbar-brand mb-0 h5">@ViewData["Title"]</span>
            </nav>

            <div class="container-fluid p-4">
                @RenderBody()
            </div>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
